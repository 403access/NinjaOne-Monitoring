{
  "name": "ninjaone-signal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Signal — a causal monitoring console for NinjaOne",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun build src/index.html --outdir=dist --target=browser --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
