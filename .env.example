# ── Runtime ────────────────────────────────────────────────────────────────
PORT=3000
# demo | live | auto  (auto = live when credentials are present, otherwise demo)
NINJA_MODE=demo

# ── NinjaOne Public API 2.0 ────────────────────────────────────────────────
# Region base URL: https://app.ninjarmm.com (US), https://eu.ninjarmm.com (EU),
# https://oc.ninjarmm.com (Oceania). Use the hostname of your NinjaOne tenant.
NINJA_BASE_URL=https://app.ninjarmm.com

# OAuth 2.0 client credentials from Administration > Apps > API.
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=
NINJA_SCOPE=monitoring management

# Optional: how often the background cache refreshes (seconds). 0 disables it.
NINJA_REFRESH_SECONDS=120

# Optional: path for the local SQLite database.
DATABASE_PATH=.data/signal.sqlite
